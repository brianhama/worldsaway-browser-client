# Optional local cache containing mag/ and wsres/. Never put credentials here.
# ALTAWAY_CLIENT_DIR=/absolute/path/to/client-cache

HOST=127.0.0.1
PORT=4173
# Defaults to the local world server; configure its public URL for hosting.
WORLDSAWAY_BACKEND_URL=http://127.0.0.1:8080
# WORLDSAWAY_BACKEND_URL=https://world.example.com
# Public hosting requires an exact HTTPS origin and HOST=0.0.0.0.
# ALTAWAY_PUBLIC_ORIGIN=https://client.example.com
# TCLSH=/absolute/path/to/tclsh8.6
